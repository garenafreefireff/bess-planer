APP_NAME="BESS Planner API"
ENVIRONMENT=local
APP_DEBUG=false
API_V1_PREFIX=/api/v1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=bess_planner
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","http://127.0.0.1:3001"]
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
AUTH_SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=bess_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=
PASSWORD_HASH_ITERATIONS=210000
STORAGE_DIRECTORY=storage/uploads
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=6
RATE_LIMIT_QUICK_SIZING_PER_MINUTE=20
RATE_LIMIT_LEAD_CAPTURE_PER_MINUTE=10
RATE_LIMIT_SIZING_LAB_PER_MINUTE=4
ANALYSIS_MAX_CONCURRENCY=2
ANALYSIS_TIMEOUT_SECONDS=300
NOTIFICATION_OUTBOX_ENABLED=true
SALES_NOTIFICATION_EMAIL=sales@datainsight.vn
